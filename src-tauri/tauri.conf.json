{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iMessenger",
  "version": "1.1.0",
  "identifier": "asia.so1.imessenger",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "iMessenger — unofficial desktop app for Messenger on the web",
