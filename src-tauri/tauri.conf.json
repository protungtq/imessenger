    "copyright": "© 2026 Lương Văn Tùng. Based on fMess © fMess contributors (MIT). Messenger is a trademark of Meta Platforms, Inc.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMTBBQzY2MDZBQjIxMEQKUldRTklhc0dacXdRWC9jV3BuTHBCNWpkY1dleU1OaWFST0hBQlcxdnl1NUdobHRsMzBteTdCZHMK",
      "endpoints": [
        "https://github.com/protungtq/imessenger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}